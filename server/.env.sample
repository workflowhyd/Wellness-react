# Copy this to `server/.env` and fill values (DO NOT commit real secrets).

# MongoDB Atlas connection string (replace <user>, <password>, and <dbname>):
# Example:
# mongodb+srv://myUser:myPassword@cluster0.abcd.mongodb.net/glorywellness?retryWrites=true&w=majority
MONGODB_URI=

# Admin password for the dashboard (choose a strong value):
ADMIN_PASSWORD=

# JWT signing secret (generate with the command below):
JWT_SECRET=

# Exact URL the frontend is deployed at (no trailing slash). Required for CORS:
# e.g. https://deepskyblue-jackal-392124.hostingersite.com
ALLOWED_ORIGIN=

# Port (defaults to 4000 if unset):
PORT=4000

# Notes / quick commands:
# 1) Generate a strong JWT secret locally:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 2) How to build a MongoDB Atlas URI:
#    - In Atlas: Project -> Clusters -> Connect -> Drivers -> Node.js
#    - Copy the connection string, replace <username> and <password>, and set a database name
#    - Make sure your DB user has a password and Network Access (IP whitelist) allows your host.
# 3) For quick testing allow access from any IP (NOT RECOMMENDED for production):
#    In Atlas Network Access -> Add IP Address -> 0.0.0.0/0
# 4) On Hostinger (Node app) set the same env names and restart the Node process.
# 5) On the Hostinger static site set `VITE_API_BASE_URL` to the public URL of your Node backend,
#    for example: https://<your-backend-host>/api (NOT the static frontend host unless backend is served there).
