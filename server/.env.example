# Copy to .env for local dev, or set these as environment variables in
# Hostinger's Node.js app panel for production. Never commit the real .env.

# MongoDB Atlas connection string (free M0 cluster is fine).
# Atlas dashboard -> Connect -> Drivers -> copy the connection string,
# fill in the real password, and make sure it includes a database name,
# e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/glorywellness
MONGODB_URI=

# Password for the Admin Dashboard login.
ADMIN_PASSWORD=

# Random long string used to sign admin login tokens (any value works, just
# keep it secret and don't reuse it elsewhere). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Exact URL the frontend is deployed at (no trailing slash) — required for CORS.
ALLOWED_ORIGIN=http://localhost:5173

PORT=4000
